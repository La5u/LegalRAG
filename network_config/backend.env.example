# Environment variables for the LegalRAG backend server, in a split
# frontend/backend deployment. Copy to backend.env (untracked) and fill in.
#
# Same secret must be set as X-Internal-Proxy-Secret in nginx-frontend.conf
# on the frontend server. Generate it with:
#   openssl rand -hex 32
LEGALRAG_PROXY_SECRET=

# Existing app config — see README.md at the project root for the full list.
LEGALRAG_NEO4J_URI=bolt://127.0.0.1:7687
LEGALRAG_NEO4J_USER=neo4j
LEGALRAG_NEO4J_PASSWORD=
LEGALRAG_OLLAMA_URL=http://127.0.0.1:11434
